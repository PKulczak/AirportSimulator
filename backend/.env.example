SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=airportdb
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

QUEUE_BROKER=dramatiq.brokers.redis.RedisBroker
QUEUE_URL=redis://localhost:6379/0

# Redis for the Channels websocket layer (status push). Optional — defaults to
# QUEUE_URL. Live websockets also require running an ASGI server (e.g.
# `daphne backend.asgi:application` or `hypercorn backend.asgi:application`);
# with `daphne` installed, `manage.py runserver` serves ASGI automatically.
# CHANNEL_LAYER_URL=redis://localhost:6379/0

# Slice C.1 — Redis-backed cache, shared by every worker process (used by DRF's
# throttles below). Optional — defaults to QUEUE_URL, same Redis instance the
# dramatiq/channels config above already depends on. Override to point the
# cache at a separate Redis instance/db if you don't want to share one.
# CACHE_URL=redis://localhost:6379/0

AIRCRAFT_SPEED_IN_KNOTS=140

# Slice 9.1 — Authentication. False (the default) leaves every endpoint open,
# matching pre-auth behaviour. Only flip to True once the frontend login flow
# has been confirmed end to end AND at least one real user exists to log in
# as (there's no self-serve signup — provision one via `manage.py
# createsuperuser` or the Django admin).
REQUIRE_AUTH=False

# Rate limit on POST /api/auth/login/ (django-rest-framework throttle syntax,
# e.g. "10/min", "100/hour") — guards against password brute-forcing once
# REQUIRE_AUTH is on. Shared across every worker process via the Redis-backed
# CACHES config above (Slice C.1) rather than enforced per-process.
LOGIN_THROTTLE_RATE=10/min

# Slice B.2 — self-serve signup / password reset. Same throttle reasoning as
# LOGIN_THROTTLE_RATE above, guarding account creation and password-reset
# requests respectively instead of login attempts.
REGISTER_THROTTLE_RATE=5/hour
PASSWORD_RESET_THROTTLE_RATE=5/hour

# Slice B.2 — password reset emails. EMAIL_BACKEND defaults to Django's
# console backend (prints the email to the runserver's stdout instead of
# actually sending it) so dev/CI never needs real SMTP creds. For a real
# deployment, set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=...
#   EMAIL_HOST_PASSWORD=...
#   EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@airport-modelling.local

# Base URL of the deployed frontend SPA — used to build the link inside a
# password-reset email (the backend has no page of its own to send someone
# to). Defaults to the local Vite dev server.
FRONTEND_BASE_URL=http://localhost:3000

# Slice C.2 — how many Pending/Running runs one authenticated user can have
# queued at once (single-run + sweep creation combined), protecting the
# shared dramatiq queue/worker capacity from one user repeatedly queuing more
# work than it can ever drain. Keep this comfortably above the sweep size cap
# (50 runs) so a single full-size sweep always fits for a user starting from
# zero.
MAX_IN_FLIGHT_SIMULATIONS_PER_USER=100
