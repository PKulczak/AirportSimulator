SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=airportdb
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

QUEUE_BROKER=dramatiq.brokers.redis.RedisBroker
QUEUE_URL=redis://localhost:6379/0

# Redis for the Channels websocket layer (status push). Optional — defaults to
# QUEUE_URL. Live websockets also require running an ASGI server (e.g.
# `daphne backend.asgi:application` or `hypercorn backend.asgi:application`);
# with `daphne` installed, `manage.py runserver` serves ASGI automatically.
# CHANNEL_LAYER_URL=redis://localhost:6379/0

AIRCRAFT_SPEED_IN_KNOTS=140
